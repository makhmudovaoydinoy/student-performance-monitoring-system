# Nusxa oling: cp .env.example .env  va qiymatlarni almashtiring
# Lokal sinov (SQLite):
DATABASE_URL=sqlite:///./student_monitoring.db
# PostgreSQL (docker-compose):
# DATABASE_URL=postgresql+psycopg2://monitor:monitor_pass@db:5432/student_monitoring
# Cloud SQL (Cloud Run, unix socket):
# DATABASE_URL=postgresql+psycopg2://appuser:PAROL@/student_monitoring?host=/cloudsql/PROJECT:REGION:INSTANCE

SECRET_KEY=replace-with-a-long-random-secret-key
ACCESS_TOKEN_MINUTES=480

# Birinchi ishga tushishda baza bo'sh bo'lsa shu admin yaratiladi
ADMIN_USERNAME=admin
ADMIN_PASSWORD=makhmudova0707
ADMIN_EMAIL=your-email@example.com

# Cloud Scheduler uchun maxfiy token (bo'sh bo'lsa endpoint o'chiq)
SCHEDULER_TOKEN=

CORS_ORIGINS=*

# Ixtiyoriy: email yuborish (bo'sh bo'lsa faqat tizim ichidagi xabarnoma)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
